// RUN: marco -mc1 %s -emit-mlir-bmodelica -o - | FileCheck %s

// CHECK:       bmodelica.model @M {
// CHECK-NEXT:      bmodelica.variable @r : !bmodelica.variable<3x!bmodelica<record @Test::@R>>
// CHECK-NEXT:  }

// A single top-level package encloses the classes, as in the Base Modelica
// format, and is removed.
package Outer
    package Test
        record R
        end R;

        model M
            R[3] r;
        end M;
    end Test;
end Outer;
