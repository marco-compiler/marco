// RUN: marco -mc1 %s -emit-mlir-bmodelica -o - | FileCheck %s

// CHECK-LABEL: @Foo
// CHECK:       bmodelica.algorithm {
// CHECK-NEXT:      %[[x:.*]] = bmodelica.variable.get @x : tensor<2x!bmodelica.real>
// CHECK-NEXT:      bmodelica.variable.set @y, 
// CHECK-NEXT:  }

function Foo
    input Real[2] x;
    output Real[2] y;
algorithm
    y := x;
end Foo;
